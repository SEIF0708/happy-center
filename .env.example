# Public Supabase project URL and anonymous (publishable) key.
# These are safe to expose in the browser when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER put this in client code or NEXT_PUBLIC_* variables.
# Used only by local administrative scripts (provision-supervisor, optional demo seed).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only set to "true" when running demo seed against a non-production project.
ALLOW_DEMO_SEED=false

# Optional: comma-separated extra origins for local development.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
